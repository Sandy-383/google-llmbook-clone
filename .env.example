# Copy to `.env` and adjust. `.env` is git-ignored; never commit real secrets.
# Every value has a working default for local development, so `.env` is optional on your laptop.

# --- Postgres (change the password for any shared or production deployment) ---
POSTGRES_USER=llmbook
POSTGRES_PASSWORD=llmbook
POSTGRES_DB=llmbook

# --- App ---
ENVIRONMENT=development        # development | production
COOKIE_SECURE=false            # must be true in production (HTTPS only)
ALLOW_REGISTRATION=true        # set false to stop new sign-ups on a private deployment
# When the app is reachable from the internet (scripts/share.ps1), require this code to sign up
# and share it only with the people you invite. Leave empty for open sign-up.
REGISTRATION_CODE=

# --- OCR for scanned PDFs ---
# Extra Tesseract language packs baked into the image (space-separated Debian names), and the
# languages to use. Example for English + Hindi + Kannada:
#   EXTRA_OCR_LANGS=hin kan
#   OCR_LANGUAGES=eng+hin+kan
EXTRA_OCR_LANGS=
OCR_LANGUAGES=eng

# --- Local models (Ollama runs natively on the host so it can use the GPU) ---
OLLAMA_BASE_URL=http://host.docker.internal:11434
CHAT_MODEL=qwen3:8b
EMBED_MODEL=bge-m3

# --- Chat & retrieval (defaults suit an 8 GB GPU; see README "Answer quality") ---
# Context window per request. More fits more sources but needs more video memory.
CHAT_CONTEXT_TOKENS=8192
# Embed questions on the CPU (needed on 8 GB: the chat and embedding models don't fit together).
QUERY_EMBED_ON_CPU=true
# Below this similarity the app answers "not found" without calling the model.
RETRIEVAL_MIN_SIMILARITY=0.35
# Questions per user per 10 minutes.
CHAT_RATE_LIMIT=30
